{
  "version": 1,
  "name": "coding-with-docs",
  "description": "Coding with docs",
  "extends": ["../coding"],
  "prompts": ["prompt.md"],
  "environment": {
    "resourceInheritance": "none",
    "mcp": {
      "docs": {
        "tools": ["resolve-library-id", "query-docs"],
        "required": false,
        "timeoutSeconds": 30
      }
    }
  }
}
