{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OctopusGarage/ralphworks/blob/main/docs/schemas/code-review-result-v1.schema.json",
  "title": "RalphWorks code review result v1",
  "description": "UTF-8 JSON document, maximum 1048576 bytes. Revision expectation matching is an additional caller check. This schema validates structure and verdict consistency, not review truth or completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "verdict", "reviewedScope", "findings", "limitations"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseSha", "headSha", "diffSha256"],
      "properties": {
        "baseSha": {
          "type": ["string", "null"],
          "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
        },
        "headSha": {
          "type": ["string", "null"],
          "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
        },
        "diffSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "verdict": {
      "enum": ["clean", "findings", "incomplete"]
    },
    "reviewedScope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "path", "line", "title", "trigger", "consequence", "remedy", "evidence"],
        "properties": {
          "severity": {
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S",
            "allOf": [
              {
                "pattern": "^(?![A-Za-z]:)(?![\\s\\S]*(?:^|/)\\.{1,2}(?:/|$))(?![\\s\\S]*[\\\\\\u0000-\\u001f\\u007f])[^/]+(?:/[^/]+)*$"
              }
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "consequence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "remedy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "\\S"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384,
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "clean"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
