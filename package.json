{
  "name": "ralphworks",
  "version": "0.1.2",
  "description": "Bounded Ralph loop orchestrator powered by Pi.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "bin": {
    "ralph": "./dist/cli.js",
    "ralphworks": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "docs/ARCHITECTURE.md",
    "docs/USAGE.md",
    "docs/assets/ralphworks-overview.svg"
  ],
  "scripts": {
    "ralph": "node src/cli.ts run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
